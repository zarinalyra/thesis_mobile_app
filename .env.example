# Google Maps API Keys
# Get your API keys from: https://console.cloud.google.com/

# Android API Key (with Maps SDK for Android enabled)
ANDROID_GOOGLE_MAPS_API_KEY=your_android_api_key_here

# iOS API Key (with Maps SDK for iOS enabled)
IOS_GOOGLE_MAPS_API_KEY=your_ios_api_key_here

# Supabase
# Get these from your Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
